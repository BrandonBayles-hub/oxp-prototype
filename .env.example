# Entrata GenAI Gateway (template)
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored; this template is safe to commit (no secrets).
#
# If LITELLM_API_KEY or LITELLM_BASE_URL is missing, the prototype falls back
# to built-in mock answers / hardcoded fallback workflows.

# Server-side vars (local dev API routes) --------------------------------------
LITELLM_API_KEY=
LITELLM_BASE_URL=
LITELLM_DEFAULT_MODEL=

# Optional model mapping -------------------------------------------------------
LITELLM_MODEL_OPUS=
LITELLM_MODEL_GPT=
LITELLM_MODEL_KIMI=

# Client-side vars (static deploy — bundled into JS) ---------------------------
# These power the workflow generator in static exports (S3/CloudFront) where
# Next.js API routes don't exist. The GenAI Gateway has open CORS so browser
# calls work directly. For an internal dev prototype this is acceptable.
NEXT_PUBLIC_LITELLM_API_KEY=
NEXT_PUBLIC_LITELLM_BASE_URL=
NEXT_PUBLIC_LITELLM_DEFAULT_MODEL=
