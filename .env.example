# Entrata Analyst → LiteLLM proxy (template)
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored; this template is safe to commit (no secrets).
#
# These vars are SERVER-SIDE ONLY (no NEXT_PUBLIC_ prefix) — they are read by
# the /api/experts/chat route handler and never shipped to the browser.
#
# If LITELLM_API_KEY or LITELLM_BASE_URL is missing, Entrata Analyst falls back
# to its built-in mock answers, so the prototype keeps working without creds.

# Required for live answers ----------------------------------------------------
# Bearer key for your LiteLLM proxy.
LITELLM_API_KEY=
# Proxy base URL, e.g. http://localhost:4000 (with or without a trailing /v1).
LITELLM_BASE_URL=
# Model used when the picker is on "Auto" (or an unmapped selection), e.g. gpt-5.5
LITELLM_DEFAULT_MODEL=

# Optional model mapping -------------------------------------------------------
# Point each Entrata Analyst model-picker option at a real proxy model name.
# Blank entries fall back to LITELLM_DEFAULT_MODEL.
LITELLM_MODEL_OPUS=
LITELLM_MODEL_GPT=
LITELLM_MODEL_KIMI=
